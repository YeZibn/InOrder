LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
WORKFLOW_TIMEOUT_SECONDS=90
LLM_REASONING_EFFORT=
LLM_API_MODE=chat_completions
LLM_STREAMING=false
EXTRACTOR_BACKEND=langextract
# Select chat_completions (default) or responses; keep BASE_URL as the /v1 root.
LLM_API_MODE=chat_completions
LLM_MODEL=your-model
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
LLM_STREAMING=false
# 默认使用 LangExtract；仅在迁移排障时显式设为 json。
EXTRACTOR_BACKEND=langextract
