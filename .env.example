# --- LLM 凭据 ---
# Provider-specific keys take priority over the shared LLM_API_KEY fallback.
# Set LLM_API_KEY_OPENAI and/or LLM_API_KEY_DEEPSEEK per your providers;
# LLM_API_KEY is used when the provider-specific key is absent (backward compat).
LLM_API_KEY=your-api-key
# LLM_API_KEY_OPENAI=sk-openai-...
# LLM_API_KEY_DEEPSEEK=sk-deepseek-...

# --- Provider 与服务地址 ---
# Provider: openai or deepseek. The provider selects the official default root
# URL when LLM_BASE_URL is omitted; never include /chat/completions or /responses.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1

# --- 模型 ---
# OpenAI: gpt-4o-mini, gpt-4o, ...
# DeepSeek V4: deepseek-v4-flash, deepseek-v4-pro
# Note: deepseek-chat / deepseek-reasoner were deprecated on 2026-07-24.
LLM_MODEL=gpt-4o-mini

# --- 接口模式 ---
# chat_completions or responses
LLM_API_MODE=chat_completions
LLM_STREAMING=false

# --- 推理控制 ---
# Empty = provider default. OpenAI/DeepSeek accept: low, medium, high.
# DeepSeek V4 thinking mode also accepts: max (low/medium map to high).
LLM_REASONING_EFFORT=

# --- 超时与重试 ---
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
WORKFLOW_TIMEOUT_SECONDS=90

# --- 每个 API worker 的有限容量 ---
WORKFLOW_MAX_CONCURRENCY=8
WORKFLOW_MAX_WAITING=8
WORKFLOW_QUEUE_TIMEOUT_SECONDS=5
LLM_MAX_CONCURRENCY=8
LANGEXTRACT_MAX_THREADS=4

# --- 结构化抽取后端 ---
EXTRACTOR_BACKEND=langextract

# Optional remote vehicle catalog. Omit URL to use the bundled global fallback.
VEHICLE_CATALOG_RPC_URL=
VEHICLE_CATALOG_RPC_TIMEOUT=0.8
VEHICLE_CATALOG_CACHE_TTL=300
